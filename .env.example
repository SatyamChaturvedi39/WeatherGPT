# Application
APP_NAME=WeatherGPT
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=weathergpt-dev-secret-key-change-in-production-32bytes
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL or SQLite fallback)
# For local development without PostgreSQL, leave as sqlite+aiosqlite:///./weathergpt.db
DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://weathergpt:weathergpt_pass@localhost:5432/weathergpt

# Ingestion
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
DEFAULT_LAT=40.7128
DEFAULT_LON=-74.0060
DEFAULT_CITY="New York"
INGESTION_INTERVAL_HOURS=6
INGESTION_RETRIES=3

# LLM & RAG (Phase 4, configurable now)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Risk & ML
MODEL_DIR=./models_store
CACHE_TTL_SECONDS=900
